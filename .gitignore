# Claude Code runtime directories (session-specific, machine-specific)
projects/
file-history/
debug/
todos/
tasks/
sessions/
session-env/
shell-snapshots/
paste-cache/
chrome/
ide/
mcp-needs-auth-cache.json

# Claude Code internal task state (per-work-session)
MEMORY/WORK/*/tasks/

# Claude Code command history
history.jsonl

# Node/Bun
node_modules/
**/node_modules/

# Statsig analytics (Claude Code creates this)
[Ss]tatsig/

# Bun build cache
*.bun-build

# Environment files (may contain API keys)
.env
.env.local
.env.*.local

# Large install artifacts (274MB)
PAI-Install/

# Session transcripts (large jsonl)
*.jsonl

# macOS
.DS_Store

# System state caches (regenerated automatically)
*.cache
*.cache.json
*.log

# Telemetry
telemetry/

# State caches (regenerated automatically)
MEMORY/STATE/*.sh
MEMORY/STATE/*.json
MEMORY/STATE/algorithms/

# Backup rotation files
backups/

# Accidental npm/bun debris
/package.json
/package-lock.json
/bun.lock
.credentials.json
plugins/marketplaces/

# Temporary directories
tmp*/

# Heavy failure dump files (regenerated by hooks, 4+ MB)
MEMORY/LEARNING/**/tool-calls.json
MEMORY/LEARNING/**/sentiment.json

# Memory subdirectories with sensitive/generated data
MEMORY/AUDIT/
MEMORY/SECURITY/
MEMORY/RELATIONSHIP/
.venv-pytest/
.claude/worktrees/
PAI/USER/DOMAINS/construction/estimates/raw/
node_modules/
