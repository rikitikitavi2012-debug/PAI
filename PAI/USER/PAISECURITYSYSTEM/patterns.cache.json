{"version":"1.0","philosophy":{"mode":"defensive","principle":"Block catastrophic, confirm destructive, alert suspicious, allow everything else"},"bash":{"trusted":[{"pattern":"^ls\\b","reason":"Directory listing"},{"pattern":"^cat\\b","reason":"File display"},{"pattern":"^echo\\b","reason":"Echo command"},{"pattern":"^pwd$","reason":"Print working directory"},{"pattern":"^git\\s+(status|log|diff|branch|show|remote|stash\\s+list)","reason":"Safe git read operations"},{"pattern":"^bun\\s+(test|run|build)","reason":"Bun commands"},{"pattern":"^npm\\s+(test|run|list)","reason":"NPM commands"},{"pattern":"^head\\b","reason":"File head"},{"pattern":"^tail\\b","reason":"File tail"},{"pattern":"^wc\\b","reason":"Word count"},{"pattern":"^grep\\b","reason":"Search"},{"pattern":"^rg\\b","reason":"Ripgrep search"},{"pattern":"^find\\b","reason":"Find files"},{"pattern":"^which\\b","reason":"Locate command"},{"pattern":"^date$","reason":"Show date"},{"pattern":"^whoami$","reason":"Show user"}],"blocked":[{"pattern":"rm\\s+(-[a-zA-Z]*f[a-zA-Z]*\\s+)?(-[a-zA-Z]*r[a-zA-Z]*\\s+)?/\\s*$","reason":"Filesystem destruction: rm on root"},{"pattern":"rm\\s+-[a-zA-Z]*r[a-zA-Z]*\\s+-[a-zA-Z]*f[a-zA-Z]*\\s+/","reason":"Filesystem destruction: rm -rf /"},{"pattern":"rm\\s+-rf\\s+/","reason":"Filesystem destruction: rm -rf /"},{"pattern":"rm\\s+-rf\\s+~","reason":"Home directory destruction"},{"pattern":"rm\\s+-rf\\s+\\$HOME","reason":"Home directory destruction"},{"pattern":"rm\\s+-rf\\s+~/\\.claude","reason":"PAI infrastructure destruction"},{"pattern":"mkfs\\.","reason":"Filesystem formatting"},{"pattern":"dd\\s+if=/dev/(zero|random|urandom)","reason":"Disk overwrite"},{"pattern":"diskutil\\s+erase","reason":"Disk erasure"},{"pattern":":(){ :\\|:& };:","reason":"Fork bomb"},{"pattern":"gh\\s+repo\\s+delete","reason":"Repository deletion"},{"pattern":"curl.*\\|\\s*(ba)?sh","reason":"Pipe to shell execution"},{"pattern":"wget.*\\|\\s*(ba)?sh","reason":"Pipe to shell execution"},{"pattern":"